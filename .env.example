# Copy to .env, configure it, and keep .env out of Git.

# Application and exposed ports
APP_ENV=development
APP_NAME=DemocraSeek
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5434

# Shared FILOS key. Used by the FILOS LLM, embedding, and vision providers.
INSTITUTIONAL_API_KEY=

# Active: FILOS. Local fallback: llama3.1:8b, host Ollama, key ollama.
LLM_PROVIDER=openai_compatible
LLM_MODEL=datalab-2:latest
LLM_BASE_URL=https://filos.csd.auth.gr/ollama/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=180
# FILOS models are reasoning models: without this their hidden thinking can use
# the whole output budget and return an empty reply. Leave empty for local Ollama.
LLM_REASONING_EFFORT=none

# Active: FILOS. Local fallback: nomic-embed-text, 768d, host Ollama, key ollama.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=all-minilm:22m
EMBEDDING_BASE_URL=https://filos.csd.auth.gr/ollama/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=16

# Active: FILOS. Local fallback: qwen2.5vl:7b, host Ollama, key ollama.
VISION_PROVIDER=openai_compatible
VISION_MODEL=datalab-vision-1:latest
VISION_BASE_URL=https://filos.csd.auth.gr/ollama/v1
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=180
VISION_REASONING_EFFORT=none
VISION_MAX_DESCRIPTION_CHARS=900

# Mandatory cross-encoder reranking
RERANK_PROVIDER=cross_encoder
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# PostgreSQL 18, pgvector and BM25; keep URL credentials in sync.
POSTGRES_USER=democraseek
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=democraseek
VECTOR_STORE_PROVIDER=pgvector
VECTOR_STORE_URL=postgresql://democraseek:change-this-password@db:5432/democraseek
VECTOR_STORE_COLLECTION=innovade_filos_minilm_v1

# Corpus and derived artefacts
# Host paths are relative to deployment/docker-compose.yml.
CORPUS_HOST_PATH=../data/corpus
REPORT_HOST_PATH=../data/reports
CORPUS_PATH=/app/data/corpus
INDEX_PATH=/app/data/index
REPORT_PATH=/app/data/reports
CORPUS_VERSION=replace-with-approved-corpus-version
INDEX_VERSION=2
CHUNK_SIZE=1200
CHUNK_OVERLAP=180

# Retrieval; 0.65 is provisional until calibrated on the FILOS MiniLM index.
RETRIEVAL_CANDIDATE_K=10
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.65
RETRIEVAL_MAX_CONTEXT_TOKENS=4000

# Onboarding and request limits
ONBOARDING_CONFIG_PATH=/app/config/onboarding.v2.yaml
MAX_USER_INPUT_CHARS=2000
MAX_CONVERSATION_MESSAGES=12
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend build values
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8000
VITE_APP_NAME=DemocraSeek
VITE_PROJECT_NAME=INNOVADE
VITE_LOGO_URL=
