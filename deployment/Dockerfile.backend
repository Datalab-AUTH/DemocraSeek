# Backend; build from the repository root.

FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencies first so application edits do not invalidate the layer.
COPY requirements.txt ./
# Pin the base image's packaging toolchain.
RUN python -m pip install --no-cache-dir "setuptools==83.0.0"

# Install CPU-only PyTorch for the reranker.
ARG TORCH_VERSION=2.13.0
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==${TORCH_VERSION}" \
    && pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY config/ ./config/

# Mount corpus and index at runtime.
RUN mkdir -p /app/data/corpus /app/data/index /app/data/reports \
    && useradd --create-home --uid 10001 democraseek \
    && mkdir -p /home/democraseek/.cache/huggingface \
    && chown -R democraseek:democraseek /app /home/democraseek
USER democraseek

ENV PYTHONPATH=/app/backend
WORKDIR /app/backend

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3).status==200 else 1)"

# ``--factory`` avoids provider setup during import.
CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
