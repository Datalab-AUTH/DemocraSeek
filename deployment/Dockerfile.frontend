# DemocraSeek frontend: built with Vite, served as static files by nginx.
# Build context is the repository root: docker build -f deployment/Dockerfile.frontend .

FROM node:22-alpine AS build

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Baked in at build time by Vite. Override with --build-arg for other environments.
ARG VITE_API_BASE_URL=""
ARG VITE_APP_NAME="DemocraSeek"
ARG VITE_PROJECT_NAME="INNOVADE"
ARG VITE_LOGO_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_APP_NAME=$VITE_APP_NAME \
    VITE_PROJECT_NAME=$VITE_PROJECT_NAME \
    VITE_LOGO_URL=$VITE_LOGO_URL

RUN npm run build


FROM nginx:1.31.4-alpine AS runtime

# Apply Alpine security fixes published after the immutable nginx image layer
# was assembled. The application itself remains a static, unprivileged bundle.
RUN apk upgrade --no-cache

COPY --from=build /build/dist /usr/share/nginx/html
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --output-document=/dev/null http://127.0.0.1:8080/ || exit 1
