# Vite frontend served by nginx; build from the repository root.

FROM node:22-alpine AS build

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Vite embeds these values at build time.
ARG VITE_API_BASE_URL=""
ARG VITE_APP_NAME="DemocraSeek"
ARG VITE_PROJECT_NAME="INNOVADE"
ARG VITE_LOGO_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_APP_NAME=$VITE_APP_NAME \
    VITE_PROJECT_NAME=$VITE_PROJECT_NAME \
    VITE_LOGO_URL=$VITE_LOGO_URL

RUN npm run build


FROM nginx:stable-alpine AS runtime

# Apply current Alpine security fixes.
RUN apk upgrade --no-cache

COPY --from=build /build/dist /usr/share/nginx/html
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --output-document=/dev/null http://127.0.0.1:8080/ || exit 1
