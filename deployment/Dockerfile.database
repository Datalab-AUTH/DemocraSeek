FROM golang:1.25.13-alpine AS gosu_builder

# Rebuild gosu with a current Go toolchain.
RUN CGO_ENABLED=0 GOBIN=/out /usr/local/go/bin/go install \
        github.com/tianon/gosu@v0.0.0-20250923190938-6456aaa0f3c8 \
    && /out/gosu --version

FROM pgvector/pgvector:0.8.6-pg18 AS pg_textsearch_downloader

# Install a pinned, checksummed pg_textsearch BM25 release.
ARG PG_TEXTSEARCH_VERSION=1.4.0
ARG TARGETARCH

RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) archive_sha256="c2ce0585a7f09ec7fc441f1fba11888d6ad3ab51b1851d4f24a7457905d0519f" ;; \
        arm64) archive_sha256="f65bc4f46393ca66c78e4da71ae8c54d0aef9975eaf3d5b6836d0f4570c68c64" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    archive="pg-textsearch-v${PG_TEXTSEARCH_VERSION}-pg18-${TARGETARCH}.zip"; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl unzip; \
    curl --fail --location --retry 3 \
        "https://github.com/timescale/pg_textsearch/releases/download/v${PG_TEXTSEARCH_VERSION}/${archive}" \
        --output "/tmp/${archive}"; \
    echo "${archive_sha256}  /tmp/${archive}" | sha256sum --check -; \
    unzip -q "/tmp/${archive}" -d /tmp/pg_textsearch; \
    rm "/tmp/${archive}"; \
    mv /tmp/pg_textsearch/*.deb /tmp/pg_textsearch.deb; \
    rm -rf /var/lib/apt/lists/*

FROM pgvector/pgvector:0.8.6-pg18

COPY --from=pg_textsearch_downloader /tmp/pg_textsearch.deb /tmp/pg_textsearch.deb
COPY --from=gosu_builder /out/gosu /usr/local/bin/gosu

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends /tmp/pg_textsearch.deb; \
    rm -f /tmp/pg_textsearch.deb; \
    rm -rf /var/lib/apt/lists/*
